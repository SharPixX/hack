# {{ ansible_managed }}
# kubeadm v1beta4 configuration for {{ cluster_name }} (Kubernetes v{{ kubernetes_version }})
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ node_ip }}
  bindPort: 6443
nodeRegistration:
  name: {{ ansible_facts['nodename'] | lower }}
  criSocket: unix:///run/containerd/containerd.sock
  imagePullPolicy: IfNotPresent
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ node_ip }}"
{% if single_node | bool %}
  # Single-node lab: the control plane also runs workloads.
  taints: []
{% endif %}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ cluster_name }}
kubernetesVersion: v{{ kubernetes_version }}
controlPlaneEndpoint: "{{ control_plane_endpoint }}:6443"
networking:
  podSubnet: {{ pod_subnet }}
  serviceSubnet: {{ service_subnet }}
  dnsDomain: {{ cluster_dns_domain }}
apiServer:
  certSANs:
    - {{ control_plane_endpoint }}
    - {{ ansible_facts['nodename'] | lower }}
    - 127.0.0.1
    - localhost
# Expose control-plane metrics to Prometheus (kubeadm binds them to 127.0.0.1 by default).
# controller-manager/scheduler still require authn/authz on their secure ports.
controllerManager:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
scheduler:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
etcd:
  local:
    extraArgs:
      - name: listen-metrics-urls
        value: "http://0.0.0.0:2381"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
serializeImagePulls: false
containerLogMaxSize: 50Mi
containerLogMaxFiles: 3
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
metricsBindAddress: "0.0.0.0:10249"
